{
  "name": "bilight",
  "version": "0.1.4",
  "description": "Bilight Desktop Client",
  "author": "Bilight Project",
  "private": true,
  "license": "MIT",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "demo": "node scripts/demo.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "brand:sync": "node scripts/brand.mjs --write",
    "check:brand": "node scripts/brand.mjs --check",
    "build:mac": "electron-builder --mac dmg --arm64 --x64",
    "build:windows": "node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.7",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.6.0",
    "qrcode": "^1.5.4",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "artplayer": "^5.3.0",
    "artplayer-plugin-danmuku": "^5.2.0",
    "concurrently": "^9.2.0",
    "dashjs": "^5.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "app.bilight.desktop",
    "productName": "Bilight",
    "directories": {
      "output": "releases"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "desktop/**/*",
      "shared/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/tsconfig*.json"
    ],
    "mac": {
      "icon": "branding/anime-icon.png",
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Bilight 客户端安装",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
